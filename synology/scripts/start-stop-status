#!/bin/sh
# Transmission VPN Shield - start/stop/status/reconcile for DSM

set +e  # never fail hard; DSM marks package broken on non-zero

SCRIPT_DIR=$(dirname "$0")
# shellcheck source=synology/scripts/_common.sh
. "${SCRIPT_DIR}/_common.sh"

NEEDS_ACTIVATION_FLAG="${VAR_DIR}/needs-activation"
RECONCILE_SCRIPT="${PKG_DIR}/scripts/guard-reconcile"
KUMA_PUSH_SCRIPT="${PKG_DIR}/scripts/guard-push"

# --------------------------------------------------------------------------
# public IP refresher (via the VPN tunnel)
# --------------------------------------------------------------------------
get_public_ip_vpn() {
  [ -n "${VPN_IF}" ] || return
  CURL_BIN="$(command -v curl 2>/dev/null || true)"
  if [ -n "${CURL_BIN}" ]; then
    ip=$("${CURL_BIN}" -s --max-time 5 --interface "${VPN_IF}" https://ip.gioxx.org 2>/dev/null | head -n1)
    [ -n "$ip" ] && { echo "$ip"; return; }
    ip=$("${CURL_BIN}" -s --max-time 5 --interface "${VPN_IF}" https://api.ipify.org 2>/dev/null | head -n1)
    [ -n "$ip" ] && { echo "$ip"; return; }
  fi
  echo ""
}
update_public_ip_file() {
  mkdir -p "${VAR_DIR}" || true
  ip="$(get_public_ip_vpn)"
  [ -n "${ip}" ] || return
  printf "%s\n" "${ip}" > "${PUB_IP_FILE}" 2>/dev/null || true
}
start_public_ip_daemon() {
  [ "${PUBLIC_IP_REFRESH_SEC}" -gt 0 ] 2>/dev/null || return
  daemon_running "${PUB_IP_PID}" && return
  (
    while true; do
      update_public_ip_file
      sleep "${PUBLIC_IP_REFRESH_SEC}" || break
    done
  ) >/dev/null 2>&1 &
  echo $! > "${PUB_IP_PID}" 2>/dev/null || true
}
stop_public_ip_daemon() { stop_daemon "${PUB_IP_PID}"; }

# --------------------------------------------------------------------------
# Kuma push daemon
# --------------------------------------------------------------------------
start_kuma_push_daemon() {
  [ -n "${KUMA_PUSH_URL}" ] || return 0
  [ -x "${KUMA_PUSH_SCRIPT}" ] || return 0
  daemon_running "${KUMA_PUSH_PID}" && return
  ( "${KUMA_PUSH_SCRIPT}" loop ) >/dev/null 2>&1 &
  echo $! > "${KUMA_PUSH_PID}" 2>/dev/null || true
  log "Kuma push daemon started (PID $(cat "${KUMA_PUSH_PID}" 2>/dev/null))"
}
stop_kuma_push_daemon() {
  stop_daemon "${KUMA_PUSH_PID}"
  if [ -n "${KUMA_PUSH_URL}" ] && [ -x "${KUMA_PUSH_SCRIPT}" ]; then
    "${KUMA_PUSH_SCRIPT}" final-down >/dev/null 2>&1 || true
  fi
}

# --------------------------------------------------------------------------
# reconcile daemon
# --------------------------------------------------------------------------
start_reconcile_daemon() {
  [ -x "${RECONCILE_SCRIPT}" ] || return 0
  daemon_running "${RECONCILE_PID}" && return
  ( "${RECONCILE_SCRIPT}" loop ) >/dev/null 2>&1 &
  echo $! > "${RECONCILE_PID}" 2>/dev/null || true
  log "reconcile daemon started (PID $(cat "${RECONCILE_PID}" 2>/dev/null), interval=${RECONCILE_INTERVAL_SEC}s)"
}
stop_reconcile_daemon() { stop_daemon "${RECONCILE_PID}"; }

# --------------------------------------------------------------------------
# Transmission lifecycle
# --------------------------------------------------------------------------
stop_transmission() {
  command -v synopkg >/dev/null 2>&1 || return 0
  _pkg=$(resolve_tx_pkg) || return 0
  log "Stopping ${_pkg} before VPN Shield goes down..."
  synopkg stop "${_pkg}" >/dev/null 2>&1 || true
}

# --------------------------------------------------------------------------
# reconcile: converge to the correct protected state (idempotent)
# --------------------------------------------------------------------------
do_reconcile() { run_locked _reconcile_body; }

_reconcile_body() {
  load_conf
  TX_UID="$(resolve_tx_uid)"
  changed=""

  ensure_rt_table_entry >/dev/null 2>&1

  c=$(ensure_route_v4);  [ -n "$c" ] && changed="${changed} $c"
  if vpn_is_up; then ensure_lan_routes_v4; fi

  c=$(ensure_route_v6);  [ -n "$c" ] && changed="${changed} $c"
  if [ "${IPV6_MODE}" = "route" ] && vpn_is_up && vpn_has_v6; then ensure_lan_routes_v6; fi

  if [ -n "${TX_UID}" ]; then
    c=$(ensure_ip_rule_v4 "${TX_UID}"); [ -n "$c" ] && changed="${changed} $c"
    if [ "${IPV6_MODE}" != "off" ]; then
      c=$(ensure_ip_rule_v6 "${TX_UID}"); [ -n "$c" ] && changed="${changed} $c"
      # kernels < 4.10 reject per-UID IPv6 rules: warn once, keep protecting IPv4
      if ! check_ip_rule_v6 "${TX_UID}" && [ ! -f "${VAR_DIR}/.no-ipv6-uidrule" ]; then
        log "WARN: kernel refused the IPv6 per-UID rule — Transmission IPv6 is NOT isolated. Set IPV6_MODE=off in guard.conf to silence this."
        touch "${VAR_DIR}/.no-ipv6-uidrule" 2>/dev/null || true
      fi
    else
      del_ip_rule_v6 "${TX_UID}"
    fi

    # Push the peer port before the kill switch: on the very first pass the
    # owner DROP rule would otherwise be in place before loopback is exempted.
    if vpn_is_up && [ -n "${FORWARDED_PORT}" ]; then
      c=$(apply_forwarded_port); [ -n "$c" ] && changed="${changed} $c"
    fi

    if vpn_is_up; then
      c=$(ensure_killswitch "${TX_UID}"); [ -n "$c" ] && changed="${changed} $c"
    elif [ "${ENFORCE_KILLSWITCH_WHEN_VPN_DOWN}" = "1" ]; then
      c=$(ensure_killswitch "${TX_UID}"); [ -n "$c" ] && changed="${changed} $c"
    fi
  fi

  if ! vpn_is_up; then
    other=$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' \
      | grep -E '^(tun|tap|wg)[0-9]' | grep -v "^${VPN_IF}\$" | head -n1)
    [ -n "${other}" ] && log "WARN: VPN_IF=${VPN_IF} is down but ${other} is up — check the VPN connection / VPN_IF setting"
  fi

  _c=$(printf '%s' "${changed}" | sed 's/^ *//')
  [ -n "${_c}" ] && log "reconcile: ${_c}"
  return 0
}

# --------------------------------------------------------------------------
# start / stop / status
# --------------------------------------------------------------------------
do_start() {
  if [ -f "${NEEDS_ACTIVATION_FLAG}" ]; then
    log "START: package not yet activated — run activate as root via Task Scheduler."
    exit 0
  fi
  load_conf
  TX_UID="$(resolve_tx_uid)"
  [ -z "${TX_UID}" ] && log "START: user ${TRANSMISSION_USER} not found; continuing (monitor mode)." || log "START: UID=${TX_UID}"

  do_reconcile

  update_public_ip_file
  start_public_ip_daemon
  start_reconcile_daemon
  start_kuma_push_daemon
  exit 0
}

# Remove every rule/route the shield installs. Runs under the reconcile lock
# (via run_locked) so a reconcile pass that was in flight when the daemon was
# signalled cannot re-add anything after this returns.
_teardown_rules() {
  if [ -n "${TX_UID}" ]; then
    del_ip_rule_v4 "${TX_UID}"
    del_ip_rule_v6 "${TX_UID}"
    del_killswitch "${TX_UID}"
  fi
  flush_routes_v4
  flush_routes_v6
  [ "${1:-}" = "prestop" ] && remove_rt_table_entry
  return 0
}

do_stop() {
  stop_transmission
  load_conf
  TX_UID="$(resolve_tx_uid)"

  stop_reconcile_daemon
  stop_public_ip_daemon
  stop_kuma_push_daemon

  run_locked _teardown_rules stop
  log "STOP: daemons stopped, rules removed, routes flushed (rt_tables entry kept)."
  exit 0
}

do_prestop() {
  stop_transmission
  load_conf
  TX_UID="$(resolve_tx_uid)"

  stop_reconcile_daemon
  stop_public_ip_daemon
  stop_kuma_push_daemon

  run_locked _teardown_rules prestop
  log "PRESTOP: full cleanup done."
  exit 0
}

do_status() {
  load_conf
  TX_UID="$(resolve_tx_uid)"
  [ -z "${TX_UID}" ] && TX_UID="n/a"

  # opportunistically resurrect the reconcile daemon if it died — only when
  # called as root (DSM). index.cgi invokes `status` as the unprivileged web
  # user; a daemon it spawned could not fix privileged routing state nor write
  # the root-owned pid file, and every page load would leak another loop.
  if [ "$(id -u)" = "0" ] && [ ! -f "${NEEDS_ACTIVATION_FLAG}" ]; then
    start_reconcile_daemon
  fi

  RT_PRESENT=$(check_rt_table_present && echo yes || echo no)
  if [ "${TX_UID}" = "n/a" ]; then
    RULE4=no; RULE6=no
  else
    RULE4=$(check_ip_rule_v4 "${TX_UID}" && echo yes || echo no)
    RULE6=$(check_ip_rule_v6 "${TX_UID}" && echo yes || echo no)
  fi
  if vpn_is_up; then
    ROUTE4=$(route_v4_is_default && echo "via ${VPN_IF}" || echo no)
  else
    ROUTE4=$(route_v4_is_blackhole && echo "blackhole (VPN down)" || echo no)
  fi
  case "${IPV6_MODE}" in
    off)   ROUTE6="off" ;;
    block) ROUTE6=$(route_v6_is_blackhole && echo "blackhole (blocked)" || echo no) ;;
    *)     if vpn_is_up && vpn_has_v6; then
             ROUTE6=$(route_v6_is_default && echo "via ${VPN_IF}" || echo no)
           else
             ROUTE6=$(route_v6_is_blackhole && echo "blackhole (VPN down)" || echo no)
           fi ;;
  esac
  if [ "${TX_UID}" = "n/a" ]; then
    KS="no"
  elif owner_supported; then
    KS=$(check_killswitch_present "${TX_UID}" && echo yes || echo no)
  else
    KS="unsupported"
  fi
  RECON=$(daemon_running "${RECONCILE_PID}" && echo running || echo stopped)

  update_public_ip_file
  echo "Package: ${PKG_NAME}"
  echo "Transmission user: ${TRANSMISSION_USER} (UID ${TX_UID})"
  echo "VPN interface: ${VPN_IF}"
  echo "Public IP via VPN: $(cat "${PUB_IP_FILE}" 2>/dev/null || echo n/a)"
  echo "rt_tables entry present: ${RT_PRESENT}"
  echo "ip rule (v4): ${RULE4}"
  echo "ip rule (v6): ${RULE6}"
  echo "route v4: ${ROUTE4}"
  echo "route v6 (mode=${IPV6_MODE}): ${ROUTE6}"
  echo "killswitch: ${KS}"
  echo "reconcile daemon: ${RECON} (interval ${RECONCILE_INTERVAL_SEC}s)"
  [ -n "${FORWARDED_PORT}" ] && echo "Forwarded port: ${FORWARDED_PORT}"
  exit 0
}

case "${1:-}" in
  start)     do_start ;;
  stop)      do_stop ;;
  status)    do_status ;;
  prestop)   do_prestop ;;
  reconcile) do_reconcile; exit 0 ;;
  restart)   do_stop; do_start ;;
  *)
    echo "Usage: $0 {start|stop|status|restart|prestop|reconcile}"
    exit 0
    ;;
esac
