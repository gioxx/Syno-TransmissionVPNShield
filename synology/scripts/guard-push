#!/bin/sh
# Transmission VPN Shield - Uptime Kuma push daemon
#
# Modes:
#   loop        run forever, push every KUMA_PUSH_INTERVAL_SEC (default)
#   once        run a single check + push, then exit (debug / cron use)
#   final-down  push status=down with msg="shield stopped" once and exit

set +e

SCRIPT_DIR=$(dirname "$0")
# shellcheck source=synology/scripts/_common.sh
. "${SCRIPT_DIR}/_common.sh"

# port_test() now lives in _common.sh (shared with reconcile), so it keeps
# working even when this daemon isn't running (Kuma disabled).

push_kuma() {
  status="$1"; msg="$2"
  [ -n "${KUMA_PUSH_URL}" ] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  base_url="${KUMA_PUSH_URL%%\?*}"
  curl -fs --max-time 5 -G \
    --data-urlencode "status=${status}" \
    --data-urlencode "msg=${msg}" \
    "${base_url}" >/dev/null 2>&1
}

check_once() {
  uid=$(resolve_tx_uid)

  vpn=no;   vpn_is_up && vpn=yes
  rt=no;    check_rt_table_present && rt=yes
  route=no; route_v4_is_default && route=yes
  if [ -n "${uid}" ]; then
    rule=no; check_ip_rule_v4 "${uid}" && rule=yes
    ks=no;   check_killswitch_present "${uid}" && ks=yes
  else
    rule=na; ks=na
  fi

  # IPv6 verdict, per IPV6_MODE (off = not a factor)
  v6=na
  if [ -n "${uid}" ] && [ "${IPV6_MODE}" != "off" ]; then
    v6=no
    case "${IPV6_MODE}" in
      block)
        check_ip_rule_v6 "${uid}" && route_v6_is_blackhole && v6=yes ;;
      *)
        if [ "${vpn}" = "yes" ]; then
          check_ip_rule_v6 "${uid}" && route_v6_is_default && v6=yes
        else
          check_ip_rule_v6 "${uid}" && route_v6_is_blackhole && v6=yes
        fi ;;
    esac
  fi

  recon=no; daemon_running "${RECONCILE_PID}" && recon=yes
  pt=$(port_test)

  ok=1
  [ "${vpn}" = "yes" ]   || ok=0
  [ "${route}" = "yes" ] || ok=0
  [ "${rule}" = "yes" ]  || ok=0
  [ "${v6}" = "no" ]     && ok=0
  [ "${pt}" = "closed" ] && ok=0

  msg="vpn=${vpn} rt=${rt} rule=${rule} route=${route} v6=${v6} ks=${ks} recon=${recon} port=${pt}"
  if [ "${ok}" = "1" ]; then
    push_kuma up "${msg}"
  else
    push_kuma down "${msg}"
  fi
}

case "${1:-loop}" in
  once)
    load_conf
    [ -n "${KUMA_PUSH_URL}" ] || { echo "KUMA_PUSH_URL is empty; nothing to push."; exit 0; }
    check_once
    ;;
  final-down)
    load_conf
    push_kuma down "shield stopped"
    ;;
  loop|*)
    load_conf
    [ -n "${KUMA_PUSH_URL}" ] || exit 0
    [ "${KUMA_PUSH_INTERVAL_SEC}" -gt 0 ] 2>/dev/null || KUMA_PUSH_INTERVAL_SEC=60
    log "Kuma push daemon started (interval=${KUMA_PUSH_INTERVAL_SEC}s)"
    while true; do
      check_once
      sleep "${KUMA_PUSH_INTERVAL_SEC}" || break
    done
    ;;
esac
exit 0
