#!/bin/sh
# One-time activation script for Transmission VPN Shield.
# Run this as root from DSM Task Scheduler after the first install or upgrade
# to complete privilege elevation and start the package.
#
# Usage: activate [FORWARDED_PORT]
# Example (with VPN forwarded port): activate 56460
# Example (without port):            activate
#
# Task Scheduler → Create → Triggered Task → User-defined script
#   User: root
#   Command: /var/packages/transmission-vpn-shield/scripts/activate
#   (or with port: /var/packages/transmission-vpn-shield/scripts/activate 56460)

PKG_NAME="transmission-vpn-shield"
PKG_DIR="/var/packages/${PKG_NAME}"
# The persistent guard.conf (${PKG_DIR}/etc/), not the target/conf/ symlink:
# sed -i replaces files instead of editing in place, which would detach the
# symlink from its persistent target and lose the change on the next upgrade.
CONF_FILE="${PKG_DIR}/etc/guard.conf"

# Run postinst as root first: applies privilege elevation, removes the
# needs-activation flag, and seeds ${CONF_FILE} from the template if this
# is a first install (so it exists below regardless of install state).
"${PKG_DIR}/scripts/postinst"

# If a port was passed, write it into guard.conf
if [ -n "$1" ]; then
  PORT="$1"
  if [ -f "${CONF_FILE}" ]; then
    if grep -q '^FORWARDED_PORT=' "${CONF_FILE}"; then
      sed -i "s|^FORWARDED_PORT=.*|FORWARDED_PORT=\"${PORT}\"|" "${CONF_FILE}"
    else
      printf '\nFORWARDED_PORT="%s"\n' "${PORT}" >> "${CONF_FILE}"
    fi
    echo "Set FORWARDED_PORT=${PORT} in ${CONF_FILE}"
  else
    echo "Warning: ${CONF_FILE} not found, cannot set port"
  fi
fi

# keep the RPC secret file root-only
chmod 600 "${PKG_DIR}/etc/guard.secret" 2>/dev/null || true

# Apply routing rules directly as root — do not rely on DSM calling start as root,
# because DSM may cache the privilege file at install time and ignore updates.
echo "Applying routing rules directly..."
"${PKG_DIR}/scripts/start-stop-status" start

# Also tell DSM to register the package as running
synopkg start "${PKG_NAME}" 2>/dev/null || true
