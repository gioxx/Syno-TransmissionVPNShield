#!/bin/sh
# Transmission VPN Shield - migration shim for upgrades.
#
# ${PKG_DIR}/conf/ is NOT preserved by DSM — it is re-extracted from the
# package archive on every install/upgrade and about to be overwritten by
# the incoming version's default template. The only folder DSM actually
# preserves for support_conf_folder=yes packages is ${PKG_DIR}/etc/.
#
# This preupgrade hook runs while the OLD ${PKG_DIR}/conf/ is still in
# place, just before it gets replaced. If the user has a real (non-default)
# guard.conf there AND the persistent etc/ location does not yet hold one,
# rescue it across so it is not lost.

set +e

PKG_NAME="transmission-vpn-shield"
PKG_DIR="/var/packages/${PKG_NAME}"
OLD_GUARD="${PKG_DIR}/conf/guard.conf"
PERSIST_GUARD="${PKG_DIR}/etc/guard.conf"
LOG_FILE="${PKG_DIR}/var/install.log"

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] preupgrade: $1" >> "${LOG_FILE}" 2>/dev/null || true
}

mkdir -p "$(dirname "${PERSIST_GUARD}")" 2>/dev/null || true

if [ -f "${OLD_GUARD}" ] && [ ! -f "${PERSIST_GUARD}" ]; then
  if cp "${OLD_GUARD}" "${PERSIST_GUARD}" 2>/dev/null; then
    log "Rescued guard.conf from conf/ to persistent etc/ (one-time)."
  else
    log "WARN: could not rescue guard.conf to ${PERSIST_GUARD}."
  fi
fi

exit 0
