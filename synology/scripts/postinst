#!/bin/sh

PKG_NAME="transmission-vpn-shield"
PKG_DIR="/var/packages/${PKG_NAME}"
TARGET_DIR="${PKG_DIR}/target"
UI_DIR="${TARGET_DIR}/ui"
# ${PKG_DIR}/conf/ is NOT preserved across upgrades — it is part of the
# package archive itself and gets re-extracted (and overwritten) on every
# install/upgrade. It only ships the default template.
CONF_TEMPLATE="${PKG_DIR}/conf/guard.conf"
# ${PKG_DIR}/etc/ is the folder DSM actually preserves for
# support_conf_folder=yes packages (symlinked to /volume1/@appconf/<pkg>).
# This is the real persistent home for guard.conf from 0.1.9 onwards.
PERSIST_DIR="${PKG_DIR}/etc"
PERSIST_CONF="${PERSIST_DIR}/guard.conf"
CONF_DST_DIR="${TARGET_DIR}/conf"
CONF_DST="${CONF_DST_DIR}/guard.conf"
VAR_DIR="${PKG_DIR}/var"
LOG_FILE="${VAR_DIR}/install.log"
NEEDS_ACTIVATION_FLAG="${VAR_DIR}/needs-activation"

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "${LOG_FILE}" 2>/dev/null || echo "$1"
}

mkdir -p "${VAR_DIR}" "${CONF_DST_DIR}" "${PERSIST_DIR}" || true
log "Post-installation starting for package: ${PKG_NAME}"

# Seed the persistent guard.conf from the shipped template on first install
# only — never touch it again, so user edits survive every later upgrade.
if [ ! -f "${PERSIST_CONF}" ]; then
  if [ -f "${CONF_TEMPLATE}" ] && cp "${CONF_TEMPLATE}" "${PERSIST_CONF}" 2>/dev/null; then
    log "Seeded persistent guard.conf at ${PERSIST_CONF}"
  else
    log "WARN: could not seed ${PERSIST_CONF} (etc/ not writable yet by this user)."
  fi
fi

# Expose whichever guard.conf is authoritative under target/conf/ via a
# symlink so every consumer (start-stop-status, guard-push, index.cgi,
# activate, set-port) keeps finding it where it has always read it.
# Prefer the persistent copy; fall back to the read-only template only if
# the etc/ seed above failed (e.g. permissions not ready yet).
if [ -f "${PERSIST_CONF}" ]; then
  ln -sf "${PERSIST_CONF}" "${CONF_DST}" 2>/dev/null \
    && log "Linked ${CONF_DST} -> ${PERSIST_CONF}" \
    || log "WARN: could not link ${CONF_DST} -> ${PERSIST_CONF}"
elif [ -f "${CONF_TEMPLATE}" ]; then
  ln -sf "${CONF_TEMPLATE}" "${CONF_DST}" 2>/dev/null \
    && log "Linked ${CONF_DST} -> ${CONF_TEMPLATE} (fallback, etc/ not ready — settings will NOT persist until this is resolved)"
else
  log "WARN: no guard.conf source found (neither ${PERSIST_CONF} nor ${CONF_TEMPLATE})"
fi

# Migrate guard.conf across upgrades: append any known key introduced by a
# newer version that the user's persistent file does not have yet, with its
# default value + comment. Never touches existing keys/values. Best-effort,
# needs a writable etc/ (root), so it is a no-op on the first non-root pass.
migrate_guard_conf() {
  [ -f "${PERSIST_CONF}" ] || return 0
  [ -w "${PERSIST_CONF}" ] || return 0
  _appended=0
  _append_key() {
    grep -q "^${1}=" "${PERSIST_CONF}" 2>/dev/null && return 0
    {
      printf '\n# %s\n' "$3"
      printf '%s=%s\n' "$1" "$2"
    } >> "${PERSIST_CONF}" 2>/dev/null && _appended=1
  }
  _append_key RPC_PORT '"9091"'  'Transmission RPC port (see docs).'
  _append_key RECONCILE_INTERVAL_SEC '"30"' 'Seconds between self-heal reconcile passes.'
  _append_key IPV6_MODE '"route"' 'IPv6 for Transmission: route | block | off (see docs).'
  _append_key AUTOSTART_TRANSMISSION '"0"' '1 = restart Transmission after the shield starts, only when VPN up + routed.'
  [ "${_appended}" = "1" ] && log "Migrated guard.conf: appended new default keys."
  return 0
}
migrate_guard_conf

# Seed the 0600 secret file (RPC_USER / RPC_PASS) on first install; never
# overwrite an existing one so edits survive upgrades.
SECRET_TEMPLATE="${PKG_DIR}/conf/guard.secret"
SECRET_CONF="${PERSIST_DIR}/guard.secret"
if [ ! -f "${SECRET_CONF}" ] && [ -f "${SECRET_TEMPLATE}" ]; then
  cp "${SECRET_TEMPLATE}" "${SECRET_CONF}" 2>/dev/null \
    && log "Seeded ${SECRET_CONF}" \
    || log "WARN: could not seed ${SECRET_CONF}"
fi
chmod 600 "${SECRET_CONF}" 2>/dev/null || true

# Ensure UI executable
chmod +x "${UI_DIR}/index.cgi" 2>/dev/null || true
chmod +x "${PKG_DIR}/scripts/guard-reconcile" "${PKG_DIR}/scripts/guard-push" 2>/dev/null || true

# Expose UI via webman
WEB_UI_LINK="/usr/syno/synoman/webman/3rdparty/${PKG_NAME}"
if ln -sf "${UI_DIR}" "${WEB_UI_LINK}" 2>/dev/null; then
  log "Created web interface symlink at ${WEB_UI_LINK}"
else
  log "Warning: failed to create web interface symlink at ${WEB_UI_LINK}"
fi

# Make sure index.conf and config have readable perms for DSM menu
for f in index.conf config; do
  if [ -f "${UI_DIR}/${f}" ]; then
    chmod 644 "${UI_DIR}/${f}" 2>/dev/null || true
  fi
done

# Privilege elevation requires root. DSM runs postinst as a restricted user on
# first install / upgrade, so we mark the package as needing activation and
# exit cleanly (status 0). The package shows as "Installed" in Package Center
# and the web UI guides the user through the one-time activation step.
# When the user runs /var/packages/transmission-vpn-shield/scripts/activate as
# root via Task Scheduler, postinst is called again as root, the elevation is
# applied and the needs-activation flag is removed.
if [ "$(id -u)" -ne 0 ]; then
  touch "${NEEDS_ACTIVATION_FLAG}"
  log "Not running as root — package marked as needing activation."
  log "Open the web UI and follow the on-screen instructions."
  exit 0
fi

# Running as root: apply privilege elevation
"$(dirname "$0")/_elevate"
rm -f "${NEEDS_ACTIVATION_FLAG}"
log "Post-installation completed successfully (elevated)"
exit 0
