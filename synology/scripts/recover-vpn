#!/bin/sh
# One-shot recovery script that reconnects the DSM VPN Center connection and
# forces an immediate reconcile, for the case where the tunnel is up but a
# VPN provider's forwarded port did not rebind to the current session (seen
# with AirVPN: the tunnel looks healthy but the forwarded port stays closed
# until the VPN connection itself is redialed).
#
# Every step is written to var/shield.log too (not just stdout), so a run
# triggered from Task Scheduler shows up in the web UI's log panel, not
# only in the task's own run result.
#
# DSM-VPN-Center only: this drives the same DSM web API the Control Panel ->
# VPN "Connect" button uses (SYNO.Core.Network.VPN). It does nothing useful
# for a third-party OpenVPN/WireGuard client — reconnect that from its own
# UI. `synovpnc reconnect` (the CLI tool) turned out to be unreliable for
# this: it reports success without actually redialing when DSM still
# considers the connection up, so it is not used here.
#
# Needs the exact profile name shown in Control Panel -> VPN -> the
# connection list, either as $1 here or as DSM_VPN_NAME in guard.conf (the
# argument wins when both are given). The profile's internal id is looked
# up by name via the same web API, across every VPN Center connection type
# (imported OpenVPN config, manual OpenVPN, L2TP, PPTP) — DSM_VPN_PROTOCOL
# is not needed for this and is kept only for backward compatibility.
#
# The API's "connect" method doesn't force a redial of an already-connected
# profile either (DSM's own UI only offers whichever of connect/disconnect
# applies to the current state), so this explicitly disconnects first, then
# connects — the same two steps as manually clicking Disconnect then
# Connect in Control Panel -> VPN.
#
# Disconnecting also tears down VPN_IF. On DSM builds without the xt_owner
# kill switch, that removes table 200's only route and nothing stops
# Transmission's traffic from falling through to the main table for the
# few seconds the interface is gone — so Transmission is stopped first
# here, exactly like recover-heartbeat does around a shield restart, and
# only started back up once the tunnel is confirmed up again.
#
# Task Scheduler -> Create -> Triggered Task -> User-defined script
#   User: root
#   Enabled: leave unchecked (run on demand)
#   Command: /var/packages/transmission-vpn-shield/scripts/recover-vpn
#   Or, without setting DSM_VPN_NAME in guard.conf:
#   Command: /var/packages/transmission-vpn-shield/scripts/recover-vpn AirVPN

set +e

SCRIPT_DIR=$(dirname "$0")
# shellcheck source=synology/scripts/_common.sh
. "${SCRIPT_DIR}/_common.sh"

load_conf

[ -n "${1:-}" ] && DSM_VPN_NAME="$1"

SS="${SCRIPT_DIR}/start-stop-status"
WEBAPI="/usr/syno/bin/synowebapi"
TX_PKG=$(resolve_tx_pkg || echo transmission)

# Every step goes to both stdout (so Task Scheduler's own run result still
# shows the full step-by-step output) and shield.log (so it shows up in the
# web UI's log panel too — plain `echo` never reached shield.log at all).
note() {
  mkdir -p "${VAR_DIR}" 2>/dev/null || true
  printf '[%s] recover-vpn: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "${LOG_FILE}" 2>/dev/null || true
  printf '%s\n' "$*"
}
note_err() {
  mkdir -p "${VAR_DIR}" 2>/dev/null || true
  printf '[%s] recover-vpn: ERROR: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "${LOG_FILE}" 2>/dev/null || true
  printf '%s\n' "$*" >&2
}

if [ -z "${DSM_VPN_NAME}" ]; then
  note_err "No VPN profile name given - nothing to reconnect."
  note_err "Either pass it as an argument:"
  note_err '  recover-vpn AirVPN'
  note_err "or set it in guard.conf:"
  note_err '  DSM_VPN_NAME="AirVPN"'
  exit 1
fi

if [ ! -x "${WEBAPI}" ]; then
  note_err "${WEBAPI} not found - this NAS may not use DSM VPN Center."
  exit 1
fi

# Find the profile's internal id by name across every VPN Center connection
# type. synowebapi's output has one "key" : "value" pair per line; capture
# each JSON object between its { and } and keep the one whose confname
# line matches, then pull "id" out of that block — avoids depending on a
# specific field order surviving future DSM updates.
find_vpn_id() {
  _api="$1"
  "${WEBAPI}" --exec api="${_api}" method=list version=1 'additional=["status"]' 2>/dev/null \
    | awk -v name="\"confname\" : \"${DSM_VPN_NAME}\"" '
        /{/ { rec = ""; inrec = 1 }
        inrec { rec = rec "\n" $0 }
        index($0, name) { hit = 1 }
        /}/ {
          if (inrec && hit) { print rec; exit }
          inrec = 0; hit = 0
        }
      ' \
    | grep -o '"id" : "[^"]*"' | head -n1 | sed -E 's/.*"([^"]*)"$/\1/'
}

VPN_ID=""
for _api in \
  SYNO.Core.Network.VPN.OpenVPNWithConf \
  SYNO.Core.Network.VPN.OpenVPN \
  SYNO.Core.Network.VPN.L2TP \
  SYNO.Core.Network.VPN.PPTP; do
  VPN_ID=$(find_vpn_id "${_api}")
  [ -n "${VPN_ID}" ] && break
done

if [ -z "${VPN_ID}" ]; then
  note_err "no DSM VPN Center profile named '${DSM_VPN_NAME}' found - check Control Panel -> VPN."
  exit 1
fi

note "Stopping ${TX_PKG} before the VPN reconnect..."
synopkg stop "${TX_PKG}" 2>/dev/null || true

_was_up=1
vpn_is_up || _was_up=0

note "Disconnecting DSM VPN profile '${DSM_VPN_NAME}' (id=${VPN_ID})..."
if ! "${WEBAPI}" --exec api=SYNO.Core.Network.VPN method=disconnect version=1 id="${VPN_ID}" 2>&1 \
     | grep -q '"success" : true'; then
  note_err "disconnect call failed - check the profile in Control Panel -> VPN."
  note_err "${TX_PKG} was left stopped; start it once the VPN is confirmed up."
  exit 1
fi

# If the tunnel was up, wait for it to actually go down before reconnecting.
# Without this, `connect` can be issued while the old session is still live
# and either fail or become a no-op against a session that was never
# actually torn down — which is exactly what made the earlier synovpnc-based
# approach unreliable in the first place.
if [ "${_was_up}" -eq 1 ]; then
  note "Waiting for ${VPN_IF} to actually go down..."
  _down_tries=0
  while [ "${_down_tries}" -lt 15 ]; do
    vpn_is_up || break
    _down_tries=$((_down_tries + 1))
    sleep 1
  done
  if vpn_is_up; then
    note_err "${VPN_IF} is still up after disconnect - the old session may not have been torn down."
    note_err "${TX_PKG} was left stopped; check Control Panel -> VPN and start it once confirmed."
    exit 1
  fi
fi

note "Connecting DSM VPN profile '${DSM_VPN_NAME}'..."
if ! "${WEBAPI}" --exec api=SYNO.Core.Network.VPN method=connect version=1 id="${VPN_ID}" 2>&1 \
     | grep -q '"success" : true'; then
  note_err "connect call failed - check the profile in Control Panel -> VPN."
  note_err "${TX_PKG} was left stopped; start it once the VPN is confirmed up."
  exit 1
fi

note "Waiting for ${VPN_IF} to come back up..."
_tries=0
while [ "${_tries}" -lt 30 ]; do
  vpn_is_up && break
  _tries=$((_tries + 1))
  sleep 1
done

_vpn_ok=1
if ! vpn_is_up; then
  _vpn_ok=0
fi

# Reconcile regardless of outcome — idempotent, and applies the fail-closed
# blackhole route if the tunnel really is still down.
note "Forcing a reconcile pass..."
"${SS}" reconcile

if [ "${_vpn_ok}" -eq 0 ]; then
  note_err "${VPN_IF} is still not up after reconnect - check Control Panel -> VPN."
  note_err "${TX_PKG} was left stopped; start it once the VPN is confirmed up."
  exit 1
fi

# Only restart Transmission if the shield itself is actually running the
# self-heal daemon — otherwise Transmission would run unprotected until
# something else reconciles it, with no daemon to catch the next VPN flap.
_shield_ok=0
if [ -f "${RUN_MARKER}" ]; then
  _rpid=$(cat "${RECONCILE_PID}" 2>/dev/null)
  if [ -n "${_rpid}" ] && [ -r "/proc/${_rpid}/cmdline" ] \
     && tr '\0' ' ' < "/proc/${_rpid}/cmdline" 2>/dev/null | grep -q 'guard-reconcile'; then
    _shield_ok=1
  fi
fi

if [ "${_shield_ok}" -eq 0 ]; then
  note_err "the shield's reconcile daemon isn't running - start the shield from DSM Package Center first."
  note_err "${TX_PKG} was left stopped; start it yourself once the shield is confirmed running."
  exit 1
fi

note "Starting ${TX_PKG}..."
if ! synopkg start "${TX_PKG}" 2>/dev/null; then
  note_err "synopkg start ${TX_PKG} failed - VPN is up, but Transmission needs to be started manually."
  exit 1
fi

note "Recovery sequence complete."
